{
  "name": "wordwake-contributor-baseline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3102",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "test": "npm run test:t1 && npm run test:t2",
    "test:t1": "node scripts/run-tests.mjs t1",
    "test:t2": "node scripts/run-tests.mjs t2",
    "typecheck:t1": "tsc --noEmit -p tsconfig.t1.json",
    "typecheck:t2": "tsc --noEmit -p tsconfig.t2.json"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "license": "MIT"
}
